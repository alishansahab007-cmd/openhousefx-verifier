# Copy the settings you need into your host's environment variables (the app does not read .env itself).

# --- Mailbox (SMTP) check ---------------------------------------------------
# Hostname used in EHLO and the MAIL FROM address. A real domain you own with matching reverse DNS
# gets the best acceptance from mail servers.
VERIFIER_SMTP_HELO=verify.yourdomain.com
VERIFIER_SMTP_FROM=verify@yourdomain.com
# Set to 1 to never attempt port-25 checks.
VERIFIER_SMTP_DISABLED=0
# Mailbox check through ZeroBounce's HTTPS API when port 25 is blocked (e.g. on Render). Billed by ZeroBounce.
ZEROBOUNCE_API_KEY=
# Set to "zerobounce" to always use the API, even when port 25 is open.
VERIFIER_MAILBOX_PROVIDER=

# --- Live phone line status (Twilio Lookup v2, billed per lookup) -----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_LOOKUP_FIELDS=line_type_intelligence,line_status

# --- Defaults shown in the sidebar ------------------------------------------
VERIFIER_DEFAULT_REGION=US
VERIFIER_SMTP_DEFAULT=1
VERIFIER_DOMAIN_AGE_DEFAULT=1
VERIFIER_STRICT_DEFAULT=0

# --- DNS --------------------------------------------------------------------
# Comma-separated resolver IPs; leave empty to use the operating system's DNS.
VERIFIER_DNS_NAMESERVERS=

# --- Optional saved runs and Supabase run totals ----------------------------
VERIFIER_DATA_DIR=
SUPABASE_URL=
SUPABASE_KEY=
